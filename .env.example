# Server-only - never prefix with VITE_.
# Fill these in .env (local) and Vercel project settings (production).

# Service account email (from its JSON key, e.g. x@project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key from the JSON key. In Vercel's UI, paste it with literal \n
# (single backslash + n), NOT real line breaks. Do not paste real keys here.
GOOGLE_PRIVATE_KEY=
# Sheet ID from the Sheet URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=
